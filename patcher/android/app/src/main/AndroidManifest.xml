<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries>
        <package android:name="net.hexage.redcon" />
        <package android:name="com.bytes14.redconpvp.game" />
    </queries>
    <application
        android:allowBackup="false"
        android:icon="@drawable/patcher_icon"
        android:label="REDCON PvP Patcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".InstallResultReceiver" android:exported="false" />
    </application>
</manifest>
