{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redconpvp.invalid/schemas/patch-bundle-v1.json",
  "title": "REDCON PvP offline patch bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "build", "minimumPatcherVersion", "supported", "entries", "limits"],
  "properties": {
    "formatVersion": { "const": 1 },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modBuild", "protocol"],
      "properties": {
        "modBuild": { "type": "string", "minLength": 1, "maxLength": 80 },
        "protocol": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "minimumPatcherVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "supported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minSdk", "abis"],
      "properties": {
        "minSdk": { "type": "integer", "minimum": 29, "maximum": 1000 },
        "abis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["arm64-v8a"] }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInputBytes", "maxPatchBytes", "maxOutputBytes", "minFreeSpaceBytes", "sourceWindowBytes", "inputWindowBytes"],
      "properties": {
        "maxInputBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "maxPatchBytes": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "maxOutputBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "minFreeSpaceBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sourceWindowBytes": { "type": "integer", "minimum": 1048576, "maximum": 16777216 },
        "inputWindowBytes": { "type": "integer", "minimum": 65536, "maximum": 1048576 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "safeName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256"],
      "properties": {
        "name": { "$ref": "#/$defs/safeName" },
        "size": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "versionCode", "versionName", "certificateSha256", "files"],
      "properties": {
        "packageName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "versionCode": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "versionName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "certificateSha256": { "$ref": "#/$defs/sha256" },
        "files": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "$ref": "#/$defs/file" } }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256", "source", "target", "format"],
      "properties": {
        "name": { "$ref": "#/$defs/safeName" },
        "size": { "type": "integer", "minimum": 1, "maximum": 67108864 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source": { "$ref": "#/$defs/safeName" },
        "target": { "$ref": "#/$defs/safeName" },
        "format": { "const": "vcdiff-rfc3284-xdelta3-3.2.0" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input", "output", "patches"],
      "properties": {
        "id": { "$ref": "#/$defs/safeName" },
        "input": { "$ref": "#/$defs/package" },
        "output": { "$ref": "#/$defs/package" },
        "patches": { "type": "array", "minItems": 2, "maxItems": 16, "items": { "$ref": "#/$defs/patch" } }
      }
    }
  }
}
